# Local development values only; never reuse these in production.
# Compose reads this file ONLY when explicitly passed via --env-file.
WEIBIYE_DB_PASSWORD=local-development-only
WEIBIYE_DATABASE_URL=postgresql+psycopg://weibiye:local-development-only@127.0.0.1:25433/weibiye
WEIBIYE_REDIS_URL=redis://127.0.0.1:26380/0
WEIBIYE_ENVIRONMENT=development
WEIBIYE_CORS_ORIGINS=["http://127.0.0.1:35174","http://localhost:35174","http://127.0.0.1:38081"]
WEIBIYE_LLM_PROVIDER=mock
WEIBIYE_REAL_LLM_ENABLED=false
WEIBIYE_DEMO_ENABLED=true
WEIBIYE_RATE_LIMIT_BACKEND=memory
WEIBIYE_DEMO_REQUESTS_PER_MINUTE=20
WEIBIYE_AUTH_STORE_BACKEND=redis
WEIBIYE_SESSION_TTL_SECONDS=86400
# Only loopback HTTP development may use false. Production rejects this configuration.
WEIBIYE_COOKIE_SECURE=false
WEIBIYE_REQUIRE_VERIFIED_EMAIL=false
WEIBIYE_FRONTEND_ORIGIN=http://127.0.0.1:35174
# Optional private, ignored development Mock outbox (never allowed in production):
# WEIBIYE_MOCK_MAIL_DIR=D:/AIProjects/WeiBiYe/.verification/mock-mail
# No API key is required. Never place server secrets in VITE_* variables.
